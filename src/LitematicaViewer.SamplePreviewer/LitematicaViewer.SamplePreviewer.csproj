<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LitematicaViewer.SamplePreviewer</RootNamespace>
    <AssemblyName>LitematicaViewer.SamplePreviewer</AssemblyName>
    <!-- Exe 而不是 WinExe：留着控制台，Debug 桩才会落到调用它的那个终端里。 -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LitematicaViewer.Previewer\LitematicaViewer.Previewer.csproj"/>
    <!-- 数据源三件套都在这两层里：载入走 Core，网格与图集走 Meshing（连带引 Assets）。 -->
    <ProjectReference Include="..\LitematicaViewer.Core\LitematicaViewer.Core.csproj"/>
    <ProjectReference Include="..\LitematicaViewer.Meshing\LitematicaViewer.Meshing.csproj"/>
  </ItemGroup>

  <!-- 展台模式需要的零件直接链接 Sample 的源文件编译进本程序集：那些类是 internal 的，
       改成 public 才能项目引用会把 Sample 的内部设计（模式切换、自检）暴露成公共面，
       而复制一份迟早分叉。链接编译它们与本工程的类同程序集，internal 互访照常成立。
       不链接的正是不要的东西：Sidebar（设置项）、自由视角三控制器、InputSelfTest。 -->
  <ItemGroup>
    <Compile Include="..\LitematicaViewer.Previewer.Sample\DocumentSource.cs" Link="Shared\DocumentSource.cs"/>
    <Compile Include="..\LitematicaViewer.Previewer.Sample\ShotWriter.cs" Link="Shared\ShotWriter.cs"/>
    <Compile Include="..\LitematicaViewer.Previewer.Sample\Controllers\CameraModel.cs" Link="Shared\Controllers\CameraModel.cs"/>
    <Compile Include="..\LitematicaViewer.Previewer.Sample\Controllers\CameraModel.Navigation.cs" Link="Shared\Controllers\CameraModel.Navigation.cs"/>
    <Compile Include="..\LitematicaViewer.Previewer.Sample\Controllers\TurntableController.cs" Link="Shared\Controllers\TurntableController.cs"/>
    <Compile Include="..\LitematicaViewer.Previewer.Sample\Controllers\ShowcaseTarget.cs" Link="Shared\Controllers\ShowcaseTarget.cs"/>
    <Compile Include="..\LitematicaViewer.Previewer.Sample\Controllers\TurntableSpin.cs" Link="Shared\Controllers\TurntableSpin.cs"/>
  </ItemGroup>

</Project>
