<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LitematicaViewer.Previewer.Sample</RootNamespace>
    <AssemblyName>LitematicaViewer.Previewer.Sample</AssemblyName>
    <!-- Exe 而不是 WinExe：留着控制台，Debug 桩才会落到调用它的那个终端里。
         WinExe 会把 stdout 摘掉，届时桩只有挂在调试器上才看得见。 -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LitematicaViewer.Previewer\LitematicaViewer.Previewer.csproj"/>
    <!-- 数据源三件套都在这两层里：载入走 Core，网格与图集走 Meshing（连带引 Assets）。 -->
    <ProjectReference Include="..\LitematicaViewer.Core\LitematicaViewer.Core.csproj"/>
    <ProjectReference Include="..\LitematicaViewer.Meshing\LitematicaViewer.Meshing.csproj"/>
  </ItemGroup>

</Project>
